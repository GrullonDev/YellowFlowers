<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo nocturno luminoso, mismo estilo que LuminousBackground -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:centerColor="#3A1D33"
                android:endColor="#6B3A12"
                android:startColor="#1C1236" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#3DFFE082" />
        </shape>
    </item>
</layer-list>
