# ============================================================
# Amarillas — Android Signing Configuration
# ============================================================
# 1. Copy this file to `.env` (same directory — project root).
# 2. Fill in your values below.
# 3. Run `flutter build apk --release` or `flutter build appbundle`.
#
# Gradle reads this file automatically. If the keystore file
# does not exist, it is generated on the first build using
# the passwords and alias you provide here.
#
# .env is gitignored — NEVER commit it.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# These three values are mandatory for release signing.

STORE_PASSWORD=
KEY_PASSWORD=
KEY_ALIAS=upload

# ── Keystore file (choose one) ──────────────────────────────
#
# Option A — Auto-generate (easiest):
#   Leave STORE_FILE_BASE64 empty and STORE_FILE as default.
#   On the first release build, Gradle will run `keytool` to
#   create upload-keystore.jks automatically using the
#   passwords above. Works on Windows, Mac, and Linux.
#
# Option B — Base64-encoded keystore (recommended for CI):
#   Encode your existing keystore:
#     Mac/Linux:  base64 -w0 upload-keystore.jks
#     Windows:    certutil -encode upload-keystore.jks tmp.b64
#   Paste the base64 string here:
STORE_FILE_BASE64=

# Option C — Path to an existing keystore file:
#   Relative paths resolve from android/app/.
#   Absolute paths work too.
STORE_FILE=upload-keystore.jks

# ── Optional ─────────────────────────────────────────────────
# Distinguished Name for auto-generated keystores.
# Only used when generating a new keystore (Options A above).
KEY_DN=CN=Amarillas, OU=Dev, O=GrullonDev, L=City, ST=State, C=DO
